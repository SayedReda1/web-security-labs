<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mini IdP Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-dark">
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="card shadow-sm" style="width: 100%; max-width: 380px;">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <span class="badge bg-secondary mb-2">SAML Identity Provider</span>
                    <h3 class="card-title mb-0">Mini IdP</h3>
                    <p class="text-muted small mb-0">Sign in to continue to the service</p>
                </div>

                <% if (error) { %>
                    <div class="alert alert-danger py-2" role="alert"><%= error %></div>
                <% } %>

                <form method="POST" action="/login">
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control" id="username" name="username" placeholder="alice"
                            required autofocus>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" placeholder="••••••••"
                            required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <div class="alert alert-light border mt-4 mb-0 small text-muted">
                    Test users: <strong>alice</strong> / <strong>bob</strong> — password <code>password123</code>
                </div>
            </div>
        </div>
    </div>
</body>

</html>